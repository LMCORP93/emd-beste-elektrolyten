---
import BaseLayout from '@/layouts/BaseLayout.astro';
import config from '@/data/site.config';
const pageTitle = 'Legal | ' + config.siteName;
const pageDescription = 'Juridische informatie, uitgeversgegevens en redactionele disclaimer voor Beste Elektrolyten.';
const pageUrl = new URL('/impressum/', config.domain).toString();
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({ '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:config.domain},{'@type':'ListItem',position:2,name:'Legal',item:pageUrl}] })} />
  <main style="background:#fff;"><div class="container-large padding-global"><div class="padding-section-medium rich-text"><h1>Juridische informatie</h1><p><strong>Beste Elektrolyten</strong> is een onafhankelijke redactionele gids over elektrolytenproducten voor Nederland.</p><h2 id="contact">Contact</h2><p>Voor vragen: gebruik de contactgegevens vermeld op deze website.</p><h2>Externe links</h2><p>Sommige links op deze website verwijzen naar externe winkels. De prijzen voor de bezoeker blijven gelijk. Onze redactionele keuzes worden niet beïnvloed door die links.</p><h2>Redactionele onafhankelijkheid</h2><p>Onze vergelijkingen zijn redactionele koopgidsen. Ze vervangen geen medisch advies. Raadpleeg bij twijfel een zorgprofessional.</p></div></div></main>
</BaseLayout>
