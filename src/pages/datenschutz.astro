---
import BaseLayout from '@/layouts/BaseLayout.astro';
import config from '@/data/site.config';
const pageTitle = 'Privacy | ' + config.siteName;
const pageDescription = 'Privacyverklaring over gegevensverwerking, serverlogs, external links en contact voor Beste Elektrolyten.';
const pageUrl = new URL('/datenschutz/', config.domain).toString();
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({ '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:config.domain},{'@type':'ListItem',position:2,name:'Privacy',item:pageUrl}] })} />
  <main style="background:#fff;"><div class="container-large padding-global"><div class="padding-section-medium rich-text"><h1>Privacybeleid</h1><p>Dit privacybeleid legt uit welke gegevens kunnen worden verwerkt wanneer je deze website bezoekt.</p><h2>Serverlogs</h2><p>Bij het openen van de website kunnen technische toegangsgegevens zoals IP-adres, tijdstip, browser en bezochte URL worden verwerkt om de website veilig aan te bieden.</p><h2>Externe links</h2><p>Bij een klik op externe links kan de betreffende partij de klik herkennen. Externe links worden uitsluitend ter informatie aangeboden.</p><h2 id="contact">Contact</h2><p>Voor vragen: raadpleeg de contactgegevens op deze website.</p></div></div></main>
</BaseLayout>
